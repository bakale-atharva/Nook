# Copy to .env.local and fill in. Never commit real values.

# Convex (written by `npx convex dev`)
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_FRONTEND_API_URL=

# Clerk redirects
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/onboarding
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# Set these in the Convex dashboard (Settings → Environment Variables),
# not in .env.local — they're read by Convex functions:
#   CLERK_FRONTEND_API_URL        issuer for convex/auth.config.ts
#   CLERK_WEBHOOK_SIGNING_SECRET  whsec_... from Clerk → Webhooks → endpoint
#   CLERK_SECRET_KEY              only needed for clerkSync.backfill
